
<%- include('partials/header', { title: 'Contact' }) %>

<main class="container py-5">
    <section class="text-center mb-5">
        <p class="text-uppercase fw-bold">Say Hello</p>
        <h1 class="fw-bold" >Contact Me</h1>
        <p class="lead">Have a question about my coursework or projects? Feel free to reach out.</p>
    </section>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4">
                <h2 class="h4 mb-3">Let's Connect</h2>

                <p>
                    You can contact me by email at
                    <a href="mailto:mustafa.khan4@ontariotechu.net">
                        mustafa.khan4@ontariotechu.net
                    </a>
                </p>

                <form>
                    <div class="mb-3">
                        <label for="name" class="form-label">Full Name</label>
                        <input type="text" class="form-control" id="name"
                               name="name" required minlength="2" maxlength="80">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <input type="email" class="form-control" id="email"
                               name="email" required>
                    </div>

                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone (Optional)</label>
                        <input type="tel" class="form-control" id="phone" name="phone">
                    </div>

                    <div class="mb-3">
                        <label for="message" class="form-label">Message</label>
                        <textarea class="form-control" id="message" name="message"
                                  rows="5" required minlength="10" maxlength="1000"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Submit Message
                    </button>
                </form>

                <p class="text-secondary mt-3 mb-0">
                    This is a front-end demonstration form. It does not send messages.
                </p>
            </div>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
